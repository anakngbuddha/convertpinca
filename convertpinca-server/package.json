{
  "name": "convertpinca-server",
  "version": "1.0.0",
  "description": "PDF to Templated Excel Converter – Backend API & Worker",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "worker": "node worker.js",
    "migrate:dev": "npx prisma migrate dev",
    "migrate:deploy": "npx prisma migrate deploy",
    "prisma:generate": "npx prisma generate",
    "prisma:studio": "npx prisma studio",
    "build": "npx prisma generate && npx prisma migrate deploy"
  },
  "dependencies": {
    "@google/genai": "^1.7.0",
    "@prisma/client": "^5.19.1",
    "cloudinary": "^2.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "redis": "^4.7.0",
    "uuid": "^10.0.0",
    "prisma": "^5.19.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
