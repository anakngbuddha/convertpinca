{
  "name": "convertpinca-server",
  "version": "1.0.0",
  "description": "PDF to Templated Excel Converter – Backend API & Worker",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "worker": "node worker.js",
    "migrate:dev": "node node_modules/prisma/build/index.js migrate dev",
    "migrate:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
    "prisma:studio": "node node_modules/prisma/build/index.js studio",
    "build": "node node_modules/prisma/build/index.js generate && node node_modules/prisma/build/index.js db push --accept-data-loss"
  },
  "dependencies": {
    "@google/genai": "^1.7.0",
    "@prisma/client": "^5.19.1",
    "cloudinary": "^2.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "prisma": "^5.19.1",
    "redis": "^4.7.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
